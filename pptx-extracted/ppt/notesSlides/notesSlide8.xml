0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Consolidated Financial Information:</a:t></a:r><a:endParaRPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:endParaRPr></a:p><a:p><a:pPr marL="742950" lvl="1" indent="-285750" algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Centralized platform for all financial activities. Streamlined view of cash flow, budgets, and financial performance.</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Automated Financial Processes:</a:t></a:r><a:endParaRPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:endParaRPr></a:p><a:p><a:pPr marL="742950" lvl="1" indent="-285750" algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Automation of invoicing, expense tracking, and financial </a:t></a:r><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0" err="1"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>reporting.Reduces</a:t></a:r><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t> manual errors, accelerates processes, and enhances accuracy.</a:t></a:r></a:p><a:p><a:pPr algn="l"/><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>2. Optimize Your Supply Chain:</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Integrated Supply Chain Management:</a:t></a:r><a:endParaRPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:endParaRPr></a:p><a:p><a:pPr marL="742950" lvl="1" indent="-285750" algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Business Central integrates supply chain processes in one platform. Streamlined procurement, inventory, and order fulfillment.</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Demand Forecasting:</a:t></a:r><a:endParaRPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:endParaRPr></a:p><a:p><a:pPr marL="742950" lvl="1" indent="-285750" algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Utilizes data analytics for demand forecasting. Helps in optimizing inventory levels and reducing carrying costs.</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Vendor Collaboration:</a:t></a:r><a:endParaRPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:endParaRPr></a:p><a:p><a:pPr marL="742950" lvl="1" indent="-285750" algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Tools for effective communication with suppliers. Ensures a smooth and efficient supply chain network.</a:t></a:r></a:p><a:p><a:pPr algn="l"/><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>3. Boost Sales &amp; Improve Service:</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Customer Relationship Management (CRM):</a:t></a:r><a:endParaRPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:endParaRPr></a:p><a:p><a:pPr marL="742950" lvl="1" indent="-285750" algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Integrated CRM capabilities in Business Central. Helps in managing leads, opportunities, and customer interactions.</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Sales Order Processing &amp; Service Management</a:t></a:r><a:endParaRPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:endParaRPr></a:p><a:p><a:pPr marL="742950" lvl="1" indent="-285750" algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Streamlined sales order processing and order fulfillment. Enhances sales efficiency and customer satisfaction.</a:t></a:r></a:p><a:p><a:pPr marL="742950" lvl="1" indent="-285750" algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Comprehensive tools for managing service contracts and cases. Ensures timely and effective resolution of customer issues.</a:t></a:r></a:p><a:p><a:pPr algn="l"/><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>4. Deliver Projects on Time and Under Budget:</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Project Management:</a:t></a:r><a:endParaRPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:endParaRPr></a:p><a:p><a:pPr marL="742950" lvl="1" indent="-285750" algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Business Central includes project management features. Enables planning, tracking, and managing projects efficiently.</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Resource Allocation:</a:t></a:r><a:endParaRPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:endParaRPr></a:p><a:p><a:pPr marL="742950" lvl="1" indent="-285750" algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Optimizes resource allocation and utilization. Ensures that projects are adequately staffed and delivered on time.</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="1" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Budget Monitoring:</a:t></a:r><a:endParaRPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:endParaRPr></a:p><a:p><a:pPr marL="742950" lvl="1" indent="-285750" algn="l"><a:buFont typeface="Arial" panose="020B0604020202020204" pitchFamily="34" charset="0"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" b="0" i="0" dirty="0"><a:solidFill><a:srgbClr val="374151"/></a:solidFill><a:effectLst/><a:latin typeface="Söhne"/></a:rPr><a:t>Real-time monitoring of project budgets and expenses. Helps in maintaining financial discipline during project execution.</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-US" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="4" name="Slide Number Placeholder 3"/><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="sldNum" sz="quarter" idx="5"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:pPr marL="0" marR="0" lvl="0" indent="0" algn="r" defTabSz="914400" rtl="0" eaLnBrk="1" fontAlgn="auto" latinLnBrk="0" hangingPunct="1"><a:lnSpc><a:spcPct val="100000"/></a:lnSpc><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buClrTx/><a:buSzTx/><a:buFontTx/><a:buNone/><a:tabLst/><a:defRPr/></a:pPr><a:fld id="{F2DCE29A-87DB-4DD4-990D-65E5A626FEA8}" type="slidenum"><a:rPr kumimoji="0" lang="en-US" sz="1200" b="0" i="0" u="none" strike="noStrike" kern="1200" cap="none" spc="0" normalizeH="0" baseline="0" noProof="0" smtClean="0"><a:ln><a:noFill/></a:ln><a:solidFill><a:prstClr val="black"/></a:solidFill><a:effectLst/><a:uLnTx/><a:uFillTx/><a:latin typeface="Aptos" panose="02110004020202020204"/><a:ea typeface="+mn-ea"/><a:cs typeface="+mn-cs"/></a:rPr><a:pPr marL="0" marR="0" lvl="0" indent="0" algn="r" defTabSz="914400" r